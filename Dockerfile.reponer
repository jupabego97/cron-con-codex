FROM python:3.12-slim

ENV PYTHONPATH=/app/src \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app
RUN pip install "fastapi>=0.115,<1.0" "uvicorn>=0.30,<1.0" tzdata
COPY src/app ./src/app

EXPOSE 8000
CMD ["sh", "-c", "exec uvicorn app.daily_report:create_from_env --factory --host 0.0.0.0 --port ${PORT:-8000} --no-access-log"]
